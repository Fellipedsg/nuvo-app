{
  "expo": {
    "name": "Nuvo",
    "slug": "nuvo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use o Face ID para entrar no Nuvo e confirmar ações importantes.",
        "NSCameraUsageDescription": "A câmera é usada na verificação facial (prova de vida) do cadastro."
      },
      "bundleIdentifier": "com.anonymous.nuvo-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/nuvo-app"
    }
  }
}